  "path": ["src", "tooling/wavelet-lsp/src", "tooling/vscode", "docs/src", "docs/scripts"],
  "format": ["rust", "javascript", "typescript", "jsx", "tsx"],
  "ignore": ["**/node_modules/**", "**/target/**", "**/dist/**", "**/build/**"],
