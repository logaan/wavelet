{
  "name": "wavelet",
  "displayName": "Wavelet",
  "description": "Syntax highlighting and language server support for the Wavelet language (.wlt).",
  "version": "0.2.0",
  "publisher": "wavelet",
  "license": "MIT",
  "main": "./extension.js",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "wavelet",
    "wave",
    "webassembly",
    "component-model",
    "wasm"
  ],
  "activationEvents": [
    "onLanguage:wavelet"
  ],
  "contributes": {
    "languages": [
      {
        "id": "wavelet",
        "aliases": [
          "Wavelet",
          "wavelet"
        ],
        "extensions": [
          ".wlt"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "wavelet",
        "scopeName": "source.wavelet",
        "path": "./syntaxes/wavelet.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Wavelet",
      "properties": {
        "wavelet.lsp.enable": {
          "type": "boolean",
          "default": true,
          "description": "Start the Wavelet language server (wavelet-lsp) for diagnostics, completion, hover, and symbols."
        },
        "wavelet.lsp.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to the wavelet-lsp executable. When empty, 'wavelet-lsp' is looked up on your PATH."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "scripts": {
    "check": "node scripts/check-grammar.mjs"
  },
  "devDependencies": {
    "vscode-textmate": "^9.0.0",
    "vscode-oniguruma": "^2.0.1"
  }
}
